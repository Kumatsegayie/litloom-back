HOST=0.0.0.0
PORT=1337
STRAPI_PUBLIC_URL=https://api.your-domain.com
PUBLIC_SITE_URL=https://www.your-domain.com
TRUST_PROXY=true
FORCE_HTTPS=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ALLOW_HTTP=false
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Example database override for production
# DATABASE_CLIENT=mysql
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_NAME=litloom
# DATABASE_USERNAME=litloom_user
# DATABASE_PASSWORD=change_me

# Comment moderation email notifications
ADMIN_EMAIL=litloom1@gmail.com
COMMENT_NOTIFY_EMAILS=litloom1@gmail.com
EMAIL_DEFAULT_FROM="Litloom <litloom1@gmail.com>"
EMAIL_DEFAULT_REPLY_TO=litloom1@gmail.com

# SMTP (recommended for Windows/local environments)
# For Gmail, use a Google App Password for SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=litloom1@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Litloom <litloom1@gmail.com>"
SMTP_REPLY_TO=litloom1@gmail.com

# CORS / request hardening
CORS_ORIGIN=https://www.your-domain.com
ALLOW_PRIVATE_NETWORK_ORIGINS=false
BODY_JSON_LIMIT=2mb
BODY_FORM_LIMIT=2mb
BODY_TEXT_LIMIT=2mb

# Login & spam rate limits
RATE_LIMIT_COMMENT_SUBMIT=8
RATE_LIMIT_COMMENT_WINDOW_MS=600000
RATE_LIMIT_CONTACT_SUBMIT=5
RATE_LIMIT_CONTACT_WINDOW_MS=600000
RATE_LIMIT_SUBMISSION_SUBMIT=4
RATE_LIMIT_SUBMISSION_WINDOW_MS=3600000
RATE_LIMIT_SUBSCRIBE_SUBMIT=8
RATE_LIMIT_SUBSCRIBE_WINDOW_MS=3600000
RATE_LIMIT_AUTH_LOCAL=10
RATE_LIMIT_AUTH_LOCAL_WINDOW_MS=900000
RATE_LIMIT_ADMIN_LOGIN=10
RATE_LIMIT_ADMIN_LOGIN_WINDOW_MS=900000

# Backup scheduler
BACKUP_ENABLED=true
BACKUP_RUN_ON_BOOT=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=backups

# API response cache headers
API_CACHE_MAX_AGE=60
API_CACHE_STALE_WHILE_REVALIDATE=300

# Upload optimization
UPLOAD_MAX_BYTES=20971520
